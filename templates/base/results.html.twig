{% extends 'base.html.twig' %}

{% block title %}{{ parent() }} Results for "{{ word }}"{% endblock %}

{% block body %}
<div class="cards-wrapper">
    <h1>Results for "{{ word }}"</h1>

    {% if produits is empty %}
        <h2>No results found for "{{ word }}"</h2>
    {% else %}
        <div class="cards-grid">
            {% for produit in produits %}
                <div class="card">
                    {% set image = 'images/' ~ produit.image %}
                    <a href="{{ path('app_produit', {id: produit.id}) }}">
                        <img 
                            src="{{ asset(image) }}" 
                            class="card-thumbnail" 
                            alt="{{ produit.designation }}"
                        />
                    </a>

                    <div class="card-text">
                        <h3 class="product-designation">{{ produit.designation }}</h3>
                    </div>

                    <div class="card-footer">
                        <div class="card-footer-main">
                            <p class="product-price">{{ produit.prix }} €</p>

                            <div class="card-footer-icons">
                                <a href="{{ path('app_favori', {'id': produit.id}) }}" class="favorite-btn">
                                    {% if not is_granted('IS_AUTHENTICATED_FULLY') %}
                                        <svg 
                                            xmlns="http://www.w3.org/2000/svg" 
                                            width="24" 
                                            height="24" 
                                            viewBox="0 0 24 24" 
                                            fill="none" 
                                            stroke="currentColor" 
                                            stroke-width="2"
                                        >
                                            <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
                                        </svg>
                                    {% else %}
                                        {% if produit in app.user.produits %}
                                            <svg 
                                                xmlns="http://www.w3.org/2000/svg" 
                                                width="24" 
                                                height="24" 
                                                viewBox="0 0 24 24" 
                                                fill="currentColor"
                                            >
                                                <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
                                            </svg>
                                        {% else %}
                                            <svg 
                                                xmlns="http://www.w3.org/2000/svg" 
                                                width="24" 
                                                height="24" 
                                                viewBox="0 0 24 24" 
                                                fill="none" 
                                                stroke="currentColor" 
                                                stroke-width="2"
                                            >
                                                <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
                                            </svg>
                                        {% endif %}
                                    {% endif %}
                                </a>

                                {% if is_granted('IS_AUTHENTICATED_FULLY') %}
                                    <a href="{{ path('app_cart_add', {'id': produit.id}) }}" class="cart-btn">
                                        <svg 
                                            xmlns="http://www.w3.org/2000/svg" 
                                            width="24" 
                                            height="24" 
                                            viewBox="0 0 24 24" 
                                            fill="none" 
                                            stroke="currentColor" 
                                            stroke-width="2"
                                        >
                                            <circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/>
                                            <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/>
                                        </svg>
                                    </a>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    {% endif %}
</div>
{% endblock %}
