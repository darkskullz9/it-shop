{% extends 'base.html.twig' %}

{% block title %}{{ parent() }}Orders{% endblock %}

{% block body %}
<div class="admin-container">
    <aside class="admin-sidebar">
        <h2 class="admin-sidebar-title">Admin Panel</h2>

        <nav>
            <ul class="admin-nav">
                <li><a href="{{ path('app_admin') }}" class="admin-nav-link">Dashboard</a></li>
                <li><a href="{{ path('app_admin_produits') }}" class="admin-nav-link active">Products</a></li>
                <li><a href="{{ path('app_admin_categories') }}" class="admin-nav-link">Categories</a></li>
                <li><a href="{{ path('app_admin_orders') }}" class="admin-nav-link">Orders</a></li>
            </ul>
        </nav>
    </aside>

    <main class="admin-main">
        <div class="admin-main-header">
            <h1>Orders</h1>
        </div>

        {% for message in app.flashes('success') %}
            <div class="flash flash-success">{{ message }}</div>
        {% endfor %}

        <table class="admin-table">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Customer</th>
                    <th>Date</th>
                    <th>Total</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for order in orders %}
                <tr>
                    <td>#{{ order.id }}</td>
                    <td>{{ order.user ? order.user.email : '—' }}</td>
                    <td>{{ order.dateOrder ? order.dateOrder|date('d/m/Y H:i') : '—' }}</td>
                    <td>
                        {# Calcule le total de la commande à partir de ses OrderItems #}
                        {% set total = 0 %}
                        {% for item in order.orderItems %}
                            {% set total = total + (item.quantity * item.produit.prix) %}
                        {% endfor %}
                        {{ total|number_format(2, ',', ' ') }} €
                    </td>
                    <td>
                        {# Badge coloré selon le statut #}
                        <span class="admin-status admin-status-{{ order.status|lower|replace({' ': '-'}) }}">
                            {{ order.status ?? 'Pending' }}
                        </span>
                    </td>
                    <td>
                        <a href="{{ path('app_admin_order_show', { id: order.id }) }}" class="admin-btn admin-btn-secondary">
                            View
                        </a>
                    </td>
                </tr>
                {% else %}
                <tr>
                    <td colspan="6" class="admin-empty">No orders yet.</td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </main>
</div>
{% endblock %}