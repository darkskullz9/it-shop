{% extends 'admin/base.html.twig' %}

{% block title %}{{ parent() }}Orders{% endblock %}

{% block admin_content %}
    <div class="admin-main-header">
        <h1>Orders</h1>
    </div>

    {% for message in app.flashes('success') %}
        <div class="flash flash-success">{{ message }}</div>
    {% endfor %}

    <table class="admin-table">
        <thead>
            <tr>
                <th>#</th>
                <th>Customer</th>
                <th>Date</th>
                <th>Total</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for order in orders %}
            <tr>
                <td>#{{ order.id }}</td>
                <td>{{ order.user ? order.user.email : '—' }}</td>
                <td>{{ order.dateOrder ? order.dateOrder|date('d/m/Y H:i', 'Europe/Paris') : '—' }}</td>
                <td>
                    {% set total = 0 %}
                    {% for item in order.orderItems %}
                        {% set total = total + (item.quantity * item.produit.prix) %}
                    {% endfor %}
                    {{ total|number_format(2, ',', ' ') }} €
                </td>
                <td>
                    {# Badge coloré selon le statut #}
                    <span class="admin-status admin-status-{{ order.status|lower|replace({' ': '-'}) }}">
                        {{ order.status ?? 'Pending' }}
                    </span>
                </td>
                <td>
                    <a href="{{ path('app_admin_order_show', { id: order.id }) }}" class="admin-btn admin-btn-secondary">
                        View
                    </a>
                </td>
            </tr>
            {% else %}
            <tr>
                <td colspan="6" class="admin-empty">No orders yet.</td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
{% endblock %}