{% extends 'base.html.twig' %}

{% block title %}{{ parent() }}Admin{% endblock %}

{% block body %}
<div class="admin-container">
    <aside class="admin-sidebar">
        <h2 class="admin-sidebar-title">Admin Panel</h2>

        <nav>
            <ul class="admin-nav">
                <li>
                    <a href="{{ path('app_admin') }}"
                       class="admin-nav-link {{ app.request.attributes.get('_route') == 'app_admin' ? 'active' : '' }}">
                        Dashboard
                    </a>
                </li>
                <li>
                    <a href="{{ path('app_admin_produits') }}"
                       class="admin-nav-link {{ app.request.attributes.get('_route') starts with 'app_admin_produit' ? 'active' : '' }}">
                        Products
                    </a>
                </li>
                <li>
                    <a href="{{ path('app_admin_categories') }}"
                       class="admin-nav-link {{ app.request.attributes.get('_route') starts with 'app_admin_categor' ? 'active' : '' }}">
                        Categories
                    </a>
                </li>
                <li>
                    <a href="{{ path('app_admin_orders') }}"
                       class="admin-nav-link {{ app.request.attributes.get('_route') starts with 'app_admin_order' ? 'active' : '' }}">
                        Orders
                    </a>
                </li>
                <li>
                    <a href="{{ path('app_admin_users') }}"
                    class="admin-nav-link {{ app.request.attributes.get('_route') starts with 'app_admin_user' ? 'active' : '' }}">
                        Users
                    </a>
                </li>
            </ul>
        </nav>
    </aside>

    <main class="admin-main">
        {% for message in app.flashes('success') %}
            <div class="flash flash-success">{{ message }}</div>
        {% endfor %}

        {% block admin_content %}{% endblock %}
    </main>
</div>
{% endblock %}