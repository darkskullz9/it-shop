{% extends 'base.html.twig' %}

{% block title %}{{ parent() }}Admin{% endblock %}

{% block body %}
<div class="admin-container">
    <aside class="admin-sidebar">
        <h2 class="admin-sidebar-title">Admin Panel</h2>
        <nav>
            <ul class="admin-nav">
                <li><a href="{{ path('app_admin') }}" class="admin-nav-link">Dashboard</a></li>
                <li><a href="{{ path('app_admin_produits') }}" class="admin-nav-link">Products</a></li>
                <li><a href="{{ path('app_admin_categories') }}" class="admin-nav-link">Categories</a></li>
                <li><a href="{{ path('app_admin_orders') }}" class="admin-nav-link">Orders</a></li>
            </ul>
        </nav>
    </aside>

    <main class="admin-main">
        <h1>Dashboard</h1>

        {% for message in app.flashes('success') %}
            <div class="flash flash-success">{{ message }}</div>
        {% endfor %}

        <div class="admin-cards-grid">
            <a href="{{ path('app_admin_produits') }}" class="admin-card">
                <span class="admin-card-label">Products</span>
            </a>

            <a href="{{ path('app_admin_categories') }}" class="admin-card">
                <span class="admin-card-label">Categories</span>
            </a>

            <a href="{{ path('app_admin_orders') }}" class="admin-card">
                <span class="admin-card-label">Orders</span>
            </a>
        </div>
    </main>
</div>
{% endblock %}