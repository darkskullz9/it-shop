{% extends 'base.html.twig' %}

{% block title %}{{ parent() }}Products{% endblock %}

{% block body %}
<div class="admin-container">
    <aside class="admin-sidebar">
        <h2 class="admin-sidebar-title">Admin Panel</h2>

        <nav>
            <ul class="admin-nav">
                <li><a href="{{ path('app_admin') }}" class="admin-nav-link">Dashboard</a></li>
                <li><a href="{{ path('app_admin_produits') }}" class="admin-nav-link active">Products</a></li>
                <li><a href="{{ path('app_admin_categories') }}" class="admin-nav-link">Categories</a></li>
                <li><a href="{{ path('app_admin_orders') }}" class="admin-nav-link">Orders</a></li>
            </ul>
        </nav>
    </aside>

    <main class="admin-main">
        <div class="admin-main-header">
            <h1>Products</h1>
            <a href="{{ path('app_admin_produit_new') }}" class="admin-btn">New product</a>
        </div>

        {% for message in app.flashes('success') %}
            <div class="flash flash-success">{{ message }}</div>
        {% endfor %}

        <table class="admin-table">
            <thead>
                <tr>
                    <th>Image</th>
                    <th>Name</th>
                    <th>Category</th>
                    <th>Price</th>
                    <th>Actions</th>
                </tr>
            </thead>
            
            <tbody>
                {% for produit in produits %}
                <tr>
                    <td>
                        <img 
                            src="{{ asset('uploads/' ~ produit.image) }}" 
                            alt="{{ produit.designation }}"
                            class="admin-product-thumb"
                        >
                    </td>

                    <td>{{ produit.designation }}</td>
                    <td>{{ produit.category ? produit.category.designation : '—' }}</td>
                    <td>{{ produit.prix }} €</td>

                    <td class="admin-actions">
                        <a href="{{ path('app_admin_produit_edit', { id: produit.id }) }}" class="admin-btn admin-btn-secondary">Edit</a>

                        <form 
                            action="{{ path('app_admin_produit_delete', { id: produit.id }) }}" 
                            method="POST"
                            onsubmit="return confirm('Delete this product?')"
                        >
                            <button type="submit" class="admin-btn admin-btn-danger">Delete</button>
                        </form>
                    </td>
                </tr>
                {% else %}
                <tr>
                    <td colspan="5" class="admin-empty">No products yet.</td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </main>
</div>
{% endblock %}