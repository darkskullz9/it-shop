{% extends 'admin/base.html.twig' %}

{% block title %}{{ parent() }}{{ title }}{% endblock %}

{% block admin_content %}
    <div class="admin-main-header">
        <h1>{{ title }}</h1>
        <a href="{{ path('app_admin_produits') }}" class="admin-btn admin-btn-secondary">← Back</a>
    </div>

    {{ form_start(form, { attr: { class: 'admin-form', novalidate: 'novalidate' } }) }}

        {{ form_row(form.designation) }}
        {{ form_row(form.description) }}
        {{ form_row(form.prix) }}
        {{ form_row(form.category) }}

        {% if produit is defined and produit.image %}
            <div class="admin-current-image">
                <label>Current image</label>
                <img 
                    src="{{ asset('uploads/' ~ produit.image) }}" 
                    alt="{{ produit.designation }}"
                >
                <small>Leave empty to keep this image</small>
            </div>
        {% endif %}

        {{ form_row(form.imageFile) }}

        <button type="submit" class="admin-btn">Save</button>

    {{ form_end(form) }}
{% endblock %}
