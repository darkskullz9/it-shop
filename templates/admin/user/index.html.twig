{% extends 'admin/base.html.twig' %}

{% block title %}{{ parent() }}Users{% endblock %}

{% block admin_content %}
    <div class="admin-main-header">
        <h1>Users</h1>
    </div>

    {% for message in app.flashes('error') %}
        <div class="flash flash-error">{{ message }}</div>
    {% endfor %}

    <table class="admin-table">
        <thead>
            <tr>
                <th>Email</th>
                <th>Roles</th>
                <th>Orders</th>
                <th>Actions</th>
            </tr>
        </thead>

        <tbody>
            {% for user in users %}
                <tr>
                    <td>{{ user.email }}</td>

                    <td>
                        {{ user.roles|join(', ') }}
                    </td>

                    <td>
                        {{ user.orders|length }}
                    </td>

                    <td>
                        <a 
                            href="{{ path('app_admin_user_edit', { id: user.id }) }}" 
                            class="admin-btn admin-btn-secondary"
                        >
                            Edit roles
                        </a>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="4" class="admin-empty">No users yet.</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
{% endblock %}