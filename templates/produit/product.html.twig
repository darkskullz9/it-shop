{% extends 'base.html.twig' %}

{% block title %}{{ parent() }} {{ produit.designation }}{% endblock %}

{% block body %}
<div class="main-container product-wrapper">
    <a href="{{ path('app_home') }}" class="back-btn">Back</a>

    <div class="product-details">
        <div class="product-image">
            {% set image = 'images/' ~ produit.image %}

            <img 
                src="{{ asset(image) }}" 
                alt="{{ produit.designation }}"
            />
        </div>

        <div class="product-infos">
            <h1>{{ produit.designation }}</h1>

            {% if produit.description %}
                <p class="product-description">{{ produit.description }}</p>
            {% endif %}

            <p class="product-price">{{ produit.prix }} €</p>

            {% if is_granted('IS_AUTHENTICATED_FULLY') %}
                <a href="{{ path('app_favori', {id: produit.id}) }}" class="favorite-btn">
                    {% if produit in app.user.produits %}
                        <svg 
                            xmlns="http://www.w3.org/2000/svg" 
                            width="24" 
                            height="24" 
                            viewBox="0 0 24 24" 
                            fill="currentColor"
                        >
                            <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
                        </svg>
                    {% else %}
                        <svg 
                            xmlns="http://www.w3.org/2000/svg" 
                            width="24" 
                            height="24" 
                            viewBox="0 0 24 24" 
                            fill="none" 
                            stroke="currentColor" 
                            stroke-width="2"
                        >
                            <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
                        </svg>
                    {% endif %}
                </a>
            {% endif %}

            {% if is_granted('IS_AUTHENTICATED_FULLY') %}
                <div class="quantity-cart">
                    <div class="quantity-selector">
                        <button type="button" onclick="decreaseQty()">−</button>
                        <input type="number" id="quantity" value="1" min="1" max="99" readonly />
                        <button type="button" onclick="increaseQty()">+</button>
                    </div>

                    <a href="{{ path('app_cart_add', {id: produit.id}) }}" id="add-to-cart-btn" class="btn-add-to-cart">
                        <svg 
                            xmlns="http://www.w3.org/2000/svg" 
                            width="20" 
                            height="20" 
                            viewBox="0 0 24 24" 
                            fill="none" 
                            stroke="currentColor" 
                            stroke-width="2"
                        >
                            <circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/>
                            <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/>
                        </svg>
                        Add to cart
                    </a>
                </div>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}
